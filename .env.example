# Local mode only (npm start). The hosted site keeps the key in your browser instead.
# Create a key at https://openrouter.ai/keys and give it a small spending limit.
OPENROUTER_API_KEY=

# Optional
# EVALDESK_MODEL=moonshotai/kimi-k3
# EVALDESK_JUDGE_MODEL=deepseek/deepseek-v4.1-flash
# EVALDESK_AUTO_GROUP_EVERY=5
# EVALDESK_PORT=8021
# EVALDESK_DATA_DIR=./evaldesk-data
# Read releases from the git tags of your product's repository:
# EVALDESK_RELEASE_REPO=../my-product
# EVALDESK_RELEASE_TAGS=v*
